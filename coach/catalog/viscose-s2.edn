;; Catálogo Viscose S2 — SEED de 2026-07-01 via API oficial kovaaks.com;
;; REMODELADO 2026-07-02 (QA do JP): uma entrada por SUBSKILL da taxonomia
;; oficial do bench (4 categorias × subcategorias = 14 folhas), com os
;; cenários da planilha do bench casados por regex. A subskill dominante da
;; entrada é o :drill/for dela — este arquivo é a FONTE do vocabulário.
;;
;; :thresholds (fim do arquivo) = RÉGUA por NOME EXATO, escala :percentile
;; (nível = 100 - top%, do header evxl da sheet; ranges viram ponto médio).
;; Satin/Silk (Hard) NÃO têm % na sheet — nível ESTIMADO (~96/98) por
;; interpolação da escada; o tier Expert ficou TODO FORA (ordinal, sem
;; população). Semeado 2026-07-02.
{:benchmark :viscose-s2
 :thresholds/source "viscose seed.xlsx (evxl percentis; easier/medium/hard)"
 :scenarios
 [;; ============ CONTROL TRACKING (suavidade sustentada) ============
  {:id :vs/ct-arm :match "(?i)smoothsphere viscose|whisphere viscose|smoothbot perfected"
   :category :tracking :subcategory :arm
   :skills {:control-tracking/arm 0.60 :control-tracking/blending 0.25 :control-tracking/wrist 0.15}
   :amplitude :large :target-kinematics :constant-vel :muscle {:arm 0.9 :wrist 0.1}
   :drill/for [:control-tracking/arm]}

  {:id :vs/ct-wrist :match "(?i)leapstrafes control|controlsphere superbaim|vt controlsphere viscose"
   :category :tracking :subcategory :wrist
   :skills {:control-tracking/wrist 0.60 :control-tracking/arm 0.20 :reactive-tracking/control 0.20}
   :amplitude :medium :target-kinematics :constant-vel :muscle {:wrist 0.8 :arm 0.2}
   :drill/for [:control-tracking/wrist]}

  {:id :vs/ct-fingertip :match "(?i)air angelic|cloverrawcontrol|flower.*50cm"
   :category :tracking :subcategory :fingertip
   :skills {:control-tracking/fingertip 0.60 :control-tracking/wrist 0.25 :control-tracking/blending 0.15}
   :amplitude :small :target-kinematics :constant-vel :muscle {:fingers 0.6 :wrist 0.4}
   :drill/for [:control-tracking/fingertip]}

  {:id :vs/ct-blending :match "(?i)vt preciseorb.*slower|air celestial|rawcontrolsphere|pgti voltaic"
   :category :tracking :subcategory :blending
   :skills {:control-tracking/blending 0.60 :control-tracking/arm 0.20 :control-tracking/fingertip 0.20}
   :amplitude :large :target-kinematics :erratic :muscle {:arm 0.5 :wrist 0.3 :fingers 0.2}
   :drill/for [:control-tracking/blending]}

  ;; ============ REACTIVE TRACKING (alvo imprevisível) ============
  {:id :vs/rt-control :match "(?i)ground plaza|air spectral"
   :category :tracking :subcategory :reactive-control
   :skills {:reactive-tracking/control 0.60 :control-tracking/wrist 0.20 :reactive-tracking/reading 0.20}
   :amplitude :small :target-kinematics :erratic :muscle {:wrist 0.7 :fingers 0.3}
   :drill/for [:reactive-tracking/control]}

  {:id :vs/rt-speed :match "(?i)vt aether|plink palace"
   :category :tracking :subcategory :reactive-speed
   :skills {:reactive-tracking/speed 0.60 :reactive-tracking/control 0.25 :control-tracking/arm 0.15}
   :amplitude :large :target-kinematics :erratic :muscle {:arm 0.7 :wrist 0.3}
   :drill/for [:reactive-tracking/speed]}

  {:id :vs/rt-reading :match "(?i)air pure|air voltaic invincible"
   :category :tracking :subcategory :reactive-reading
   :skills {:reactive-tracking/reading 0.60 :reactive-tracking/control 0.25 :control-tracking/blending 0.15}
   :amplitude :large :target-kinematics :erratic :muscle {:arm 0.7 :wrist 0.3}
   :drill/for [:reactive-tracking/reading]}

  ;; ============ FLICK TECH (o arremesso da mira) ============
  {:id :vs/ft-speed :match "(?i)ww\\dt voltaic|voxtargetswitch|aimerz\\+ static switching"
   :category :switching :subcategory :flick-speed
   :skills {:flick-tech/speed 0.60 :flick-tech/stability 0.25 :click-timing/precision 0.15}
   :amplitude :medium :target-kinematics :static :muscle {:wrist 0.7 :arm 0.3}
   :drill/for [:flick-tech/speed]}

  {:id :vs/ft-stability :match "(?i)1w6ts reload|beants|staticswitchingvox"
   :category :switching :subcategory :flick-stability
   :skills {:flick-tech/stability 0.60 :flick-tech/speed 0.20 :flick-tech/post-flick 0.20}
   :amplitude :medium :target-kinematics :static :muscle {:wrist 0.7 :arm 0.3}
   :drill/for [:flick-tech/stability]}

  {:id :vs/ft-micro :match "(?i)1w2ts reload|eth pasu micro|waldots"
   :category :switching :subcategory :flick-micro
   :skills {:flick-tech/micro 0.60 :flick-tech/stability 0.20 :click-timing/precision 0.20}
   :amplitude :small :target-kinematics :static :muscle {:wrist 0.6 :fingers 0.4}
   :drill/for [:flick-tech/micro]}

  {:id :vs/ft-post-flick :match "(?i)kints voltaic|domiswitch|b180t voltaic"
   :category :switching :subcategory :post-flick
   :skills {:flick-tech/post-flick 0.60 :flick-tech/speed 0.20 :flick-tech/micro 0.20}
   :amplitude :large :target-kinematics :static :muscle {:arm 0.6 :wrist 0.4}
   :drill/for [:flick-tech/post-flick]}

  ;; ============ CLICK TIMING (o instante do disparo) ============
  {:id :vs/clk-reading :match "(?i)pasu voltaic reload|bounceshot viscose|catclick"
   :category :clicking :subcategory :click-reading
   :skills {:click-timing/reading 0.60 :flick-tech/stability 0.20 :click-timing/precision 0.20}
   :amplitude :medium :target-kinematics :erratic :muscle {:wrist 0.6 :arm 0.4}
   :drill/for [:click-timing/reading]}

  {:id :vs/clk-precision :match "(?i)1w3ts pasu perfected|popcorn mv|skyclick goated"
   :category :clicking :subcategory :click-precision
   :skills {:click-timing/precision 0.60 :flick-tech/micro 0.25 :click-timing/stability 0.15}
   :amplitude :small :target-kinematics :strafing :muscle {:wrist 0.6 :fingers 0.4}
   :drill/for [:click-timing/precision]}

  {:id :vs/clk-stability :match "(?i)voxts click|floating.?heads.*viscose|psalmts viscose"
   :category :clicking :subcategory :click-stability
   :skills {:click-timing/stability 0.60 :click-timing/reading 0.20 :flick-tech/stability 0.20}
   :amplitude :medium :target-kinematics :strafing :muscle {:wrist 0.7 :arm 0.3}
   :drill/for [:click-timing/stability]}]

