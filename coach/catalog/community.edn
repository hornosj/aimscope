;; Cenários comunitários fora de benchmark — alvos de PRESCRIÇÃO (o GOAP grinda
;; estes para destravar cenários de benchmark). Ex. canônico do produto:
;; smoothsphere/whisphere/smoothbot (smooth de braço) destravam Bounce 180.
{:benchmark :community
 :thresholds/source :none
 :scenarios
 [{:id :com/smoothsphere :match "(?i)smoothsphere" :category :tracking :subcategory :smooth
   :skills {:control-tracking/arm 0.6 :control-tracking/blending 0.25 :control-tracking/fingertip 0.15}
   :amplitude :large :target-kinematics :constant-vel :muscle {:arm 0.9 :wrist 0.1}
   :drill/for [:control-tracking/arm]}

  {:id :com/whisphere :match "(?i)whisphere" :category :tracking :subcategory :smooth
   :skills {:control-tracking/arm 0.55 :control-tracking/wrist 0.25 :control-tracking/blending 0.2}
   :amplitude :large :target-kinematics :constant-vel :muscle {:arm 0.8 :wrist 0.2}
   :drill/for [:control-tracking/arm]}

  {:id :com/smoothbot :match "(?i)smoothbot" :category :tracking :subcategory :smooth
   :skills {:control-tracking/arm 0.5 :control-tracking/wrist 0.3 :control-tracking/fingertip 0.2}
   :amplitude :medium :target-kinematics :constant-vel :muscle {:arm 0.6 :wrist 0.4}
   :drill/for [:control-tracking/arm :control-tracking/wrist]}

  {:id :com/bounce-180 :match "(?i)bounce.?180" :category :switching :subcategory :stability
   :skills {:control-tracking/arm 0.3 :click-timing/precision 0.3 :reactive-tracking/reading 0.25 :flick-tech/micro 0.15}
   :amplitude :large :target-kinematics :bouncing-predictable :muscle {:arm 0.7 :wrist 0.3}}

  {:id :com/microshot-precision :match "(?i)microshot.*precision" :category :clicking :subcategory :static
   :skills {:flick-tech/micro 0.55 :click-timing/precision 0.3 :control-tracking/fingertip 0.15}
   :amplitude :micro :target-kinematics :static :muscle {:wrist 0.6 :fingers 0.4}
   :drill/for [:flick-tech/micro]}

  {:id :com/microshot-speed :match "(?i)microshot.*speed" :category :clicking :subcategory :static
   :skills {:click-timing/precision 0.45 :flick-tech/micro 0.35 :click-timing/reading 0.2}
   :amplitude :micro :target-kinematics :static :muscle {:wrist 0.6 :fingers 0.4}
   :drill/for [:click-timing/precision]}

  {:id :com/onewall-6ts-small :match "(?i)1wall.?6.?targets.?small|1w6ts.?small" :category :clicking :subcategory :static
   :skills {:flick-tech/stability 0.4 :flick-tech/micro 0.35 :click-timing/precision 0.25}
   :amplitude :small :target-kinematics :static :muscle {:wrist 0.8 :fingers 0.2}
   :drill/for [:flick-tech/stability :flick-tech/micro]}

  {:id :com/patts-easy :match "(?i)pattargetswitch|pat\\s*ts" :category :switching :subcategory :speed
   :skills {:flick-tech/stability 0.4 :reactive-tracking/reading 0.3 :click-timing/precision 0.3}
   :amplitude :medium :target-kinematics :static :muscle {:wrist 0.5 :arm 0.5}
   :drill/for [:reactive-tracking/reading]}

  {:id :com/reflex-flick :match "(?i)reflex.?flick" :category :clicking :subcategory :dynamic
   :skills {:click-timing/reading 0.5 :flick-tech/stability 0.3 :click-timing/precision 0.2}
   :amplitude :medium :target-kinematics :static :muscle {:wrist 0.7 :arm 0.3}
   :drill/for [:click-timing/reading]}]}
