;; Catálogo Voltaic S5 (KovaaK's) — CURADORIA v0.
;;
;; Fontes: blog.voltaic.gg (anúncio S5), estrutura de categorias/subcategorias
;; oficial. :match é regex case-insensitive aplicada ao nome do cenário no CSV
;; (os nomes in-game têm prefixos/sufixos de temporada, ex. "VT Pasu Rasp S5").
;;
;; HONESTIDADE: :skills são PRIOR CURADO (lore de coaching, não estudo causal) —
;; o coach recalibra por usuário com o loop previsto×realizado. :rank-thresholds
;; ficam nil até seed das sheets oficiais (:thresholds/source :pending).
;; Energia sem threshold ⇒ coach usa z-score do próprio histórico.
{:benchmark :voltaic-s5
 :thresholds/source :pending
 :scenarios
 [;; ---------------- CLICKING ----------------
  {:id :vt/pasu           :match "(?i)pasu"           :category :clicking  :subcategory :dynamic
   :tiers #{:novice :intermediate :advanced}
   :skills {:flick-tech/stability 0.4 :click-timing/precision 0.3 :flick-tech/micro 0.2 :click-timing/reading 0.1}
   :amplitude :medium :target-kinematics :strafing :muscle {:wrist 0.6 :arm 0.4}}

  {:id :vt/popcorn        :match "(?i)popcorn"        :category :clicking  :subcategory :dynamic
   :tiers #{:novice :intermediate :advanced}
   :skills {:flick-tech/stability 0.35 :click-timing/precision 0.35 :click-timing/reading 0.2 :flick-tech/micro 0.1}
   :amplitude :medium :target-kinematics :erratic :muscle {:wrist 0.7 :arm 0.3}}

  {:id :vt/onewall-ts     :match "(?i)1w\\d+ts|1wall"  :category :clicking  :subcategory :static
   :tiers #{:novice :intermediate :advanced}
   :skills {:flick-tech/stability 0.35 :flick-tech/micro 0.35 :click-timing/precision 0.3}
   :amplitude :small :target-kinematics :static :muscle {:wrist 0.8 :fingers 0.2}}

  {:id :vt/ww-t           :match "(?i)ww\\d+t"         :category :clicking  :subcategory :static
   :tiers #{:novice :intermediate :advanced}
   :skills {:flick-tech/micro 0.4 :flick-tech/stability 0.3 :click-timing/precision 0.3}
   :amplitude :small :target-kinematics :static :muscle {:wrist 0.8 :fingers 0.2}}

  {:id :vt/frogtagon      :match "(?i)frogtagon"      :category :clicking  :subcategory :linear
   :tiers #{:intermediate :advanced}
   :skills {:flick-tech/stability 0.35 :click-timing/precision 0.3 :reactive-tracking/reading 0.2 :flick-tech/micro 0.15}
   :amplitude :medium :target-kinematics :strafing :muscle {:wrist 0.5 :arm 0.5}}

  {:id :vt/floating-heads :match "(?i)floating\\s*heads" :category :clicking :subcategory :linear
   :tiers #{:intermediate :advanced}
   :skills {:flick-tech/stability 0.4 :click-timing/precision 0.3 :click-timing/reading 0.15 :flick-tech/micro 0.15}
   :amplitude :medium :target-kinematics :strafing :muscle {:wrist 0.6 :arm 0.4}}

  ;; ---------------- TRACKING ----------------
  {:id :vt/pgt            :match "(?i)pgt|plaza.?ground" :category :tracking :subcategory :precise
   :tiers #{:novice :intermediate :advanced}
   :skills {:control-tracking/wrist 0.4 :control-tracking/fingertip 0.3 :flick-tech/micro 0.3}
   :amplitude :small :target-kinematics :constant-vel :muscle {:wrist 0.8 :fingers 0.2}}

  {:id :vt/snake-track    :match "(?i)snake"          :category :tracking  :subcategory :precise
   :tiers #{:intermediate :advanced}
   :skills {:control-tracking/wrist 0.45 :control-tracking/fingertip 0.3 :flick-tech/micro 0.25}
   :amplitude :micro :target-kinematics :constant-vel :muscle {:wrist 0.6 :fingers 0.4}}

  {:id :vt/aether         :match "(?i)aether"         :category :tracking  :subcategory :reactive
   :tiers #{:novice :intermediate :advanced}
   :skills {:reactive-tracking/control 0.45 :reactive-tracking/reading 0.25 :control-tracking/wrist 0.3}
   :amplitude :medium :target-kinematics :erratic :muscle {:wrist 0.6 :arm 0.4}}

  {:id :vt/ground         :match "(?i)ground(?!.?plaza)" :category :tracking :subcategory :reactive
   :tiers #{:novice :intermediate :advanced}
   :skills {:reactive-tracking/control 0.5 :reactive-tracking/reading 0.25 :control-tracking/blending 0.25}
   :amplitude :medium :target-kinematics :erratic :muscle {:wrist 0.5 :arm 0.5}}

  {:id :vt/raw-control    :match "(?i)raw\\s*control"  :category :tracking  :subcategory :control
   :tiers #{:intermediate :advanced}
   :skills {:control-tracking/arm 0.4 :reactive-tracking/control 0.3 :reactive-tracking/reading 0.3}
   :amplitude :large :target-kinematics :erratic :muscle {:arm 0.8 :wrist 0.2}}

  {:id :vt/controlsphere  :match "(?i)controlsphere"  :category :tracking  :subcategory :control
   :tiers #{:intermediate :advanced}
   :skills {:control-tracking/arm 0.45 :reactive-tracking/reading 0.3 :control-tracking/blending 0.25}
   :amplitude :large :target-kinematics :erratic :muscle {:arm 0.8 :wrist 0.2}}

  ;; ---------------- SWITCHING ----------------
  {:id :vt/dot-ts         :match "(?i)dot\\s*ts"       :category :switching :subcategory :speed
   :tiers #{:novice :intermediate :advanced}
   :skills {:flick-tech/stability 0.35 :click-timing/precision 0.3 :click-timing/reading 0.2 :flick-tech/micro 0.15}
   :amplitude :medium :target-kinematics :static :muscle {:wrist 0.7 :arm 0.3}}

  {:id :vt/eddie-ts       :match "(?i)eddie"          :category :switching :subcategory :speed
   :tiers #{:intermediate :advanced}
   :skills {:flick-tech/stability 0.35 :click-timing/precision 0.35 :reactive-tracking/reading 0.3}
   :amplitude :large :target-kinematics :static :muscle {:arm 0.6 :wrist 0.4}}

  {:id :vt/drift-ts       :match "(?i)drift"          :category :switching :subcategory :evasive
   :tiers #{:intermediate :advanced}
   :skills {:reactive-tracking/control 0.3 :flick-tech/stability 0.3 :reactive-tracking/reading 0.25 :click-timing/precision 0.15}
   :amplitude :medium :target-kinematics :erratic :muscle {:wrist 0.6 :arm 0.4}}

  {:id :vt/fly-ts         :match "(?i)fly\\s*ts"       :category :switching :subcategory :evasive
   :tiers #{:novice :intermediate :advanced}
   :skills {:reactive-tracking/control 0.3 :reactive-tracking/reading 0.3 :flick-tech/stability 0.25 :click-timing/precision 0.15}
   :amplitude :medium :target-kinematics :erratic :muscle {:wrist 0.5 :arm 0.5}}

  {:id :vt/control-ts     :match "(?i)control\\s*ts"   :category :switching :subcategory :stability
   :tiers #{:intermediate :advanced}
   :skills {:control-tracking/arm 0.3 :flick-tech/micro 0.25 :click-timing/precision 0.25 :reactive-tracking/reading 0.2}
   :amplitude :large :target-kinematics :bouncing-predictable :muscle {:arm 0.7 :wrist 0.3}}

  {:id :vt/pentabounce    :match "(?i)pentabounce"    :category :switching :subcategory :stability
   :tiers #{:intermediate :advanced}
   :skills {:control-tracking/arm 0.35 :click-timing/precision 0.25 :reactive-tracking/reading 0.25 :flick-tech/micro 0.15}
   :amplitude :large :target-kinematics :bouncing-predictable :muscle {:arm 0.7 :wrist 0.3}}]}
