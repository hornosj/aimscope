;; Catálogo Voltaic S4 (KovaaK's) — SEED de 2026-07-02 via "voltaic seed.xlsx"
;; (VOLTAIC x KOVAAKS BENCHMARKS Season 4, sheet v1.2.9).
;;
;; Duas coisas neste arquivo, ortogonais:
;;   :scenarios  = FAMÍLIAS (prior curado de skills, mesma ressalva do S5 — lore
;;                 de coaching, não estudo causal). Regex :match casa o nome do
;;                 CSV. Ordem de carga (catalog.clj): viscose, S4, S5, community.
;;                 Pasu/onewall usam lookahead (?!.*s5) p/ NÃO roubar nomes S5.
;;   :thresholds = RÉGUA por NOME EXATO do cenário (não por família: cada família
;;                 tem 3 tiers com escalas de score diferentes). :scale :energy =
;;                 pontos [energia-VT(100..1200) score]; residual normaliza ÷12.
;;
;; STRAFES (Angle/Arc/Pat/AirStrafe) entram só em :thresholds — são pontuados por
;; MOVIMENTO, não por mira, então não viram família de skill (não poluem a
;; estimativa de mecânica). A régua deles continua factual pra quem quiser medir.
{:benchmark :voltaic-s4
 :thresholds/source "voltaic seed.xlsx (VT x KovaaK's S4, v1.2.9)"
 :scenarios
 [;; ---------------- CLICKING ----------------
  {:id :vt4/pasu       :match "(?i)pasu\\s*rasp(?!.*s5)" :category :clicking :subcategory :dynamic
   :tiers #{:novice :intermediate :advanced}
   :skills {:flick-tech/stability 0.4 :click-timing/precision 0.3 :flick-tech/micro 0.2 :click-timing/reading 0.1}
   :amplitude :medium :target-kinematics :strafing :muscle {:wrist 0.6 :arm 0.4}}

  {:id :vt4/bounceshot :match "(?i)vt\\s*bounceshot" :category :clicking :subcategory :dynamic
   :tiers #{:novice :intermediate :advanced}
   :skills {:click-timing/precision 0.35 :flick-tech/stability 0.3 :click-timing/reading 0.2 :reactive-tracking/reading 0.15}
   :amplitude :medium :target-kinematics :erratic :muscle {:wrist 0.6 :arm 0.4}}

  {:id :vt4/onewall    :match "(?i)1w\\d+ts\\s+rasp(?!.*s5)" :category :clicking :subcategory :static
   :tiers #{:novice :intermediate :advanced}
   :skills {:flick-tech/stability 0.35 :flick-tech/micro 0.35 :click-timing/precision 0.3}
   :amplitude :small :target-kinematics :static :muscle {:wrist 0.8 :fingers 0.2}}

  {:id :vt4/multiclick :match "(?i)multiclick" :category :clicking :subcategory :static
   :tiers #{:novice :intermediate :advanced}
   :skills {:click-timing/precision 0.4 :flick-tech/stability 0.3 :flick-tech/micro 0.3}
   :amplitude :small :target-kinematics :static :muscle {:wrist 0.7 :fingers 0.3}}

  ;; ---------------- TRACKING ----------------
  {:id :vt4/smoothbot  :match "(?i)vt\\s*smoothbot" :category :tracking :subcategory :precise
   :tiers #{:novice :intermediate :advanced}
   :skills {:control-tracking/wrist 0.45 :control-tracking/arm 0.3 :control-tracking/fingertip 0.25}
   :amplitude :medium :target-kinematics :constant-vel :muscle {:wrist 0.6 :arm 0.4}}

  {:id :vt4/preciseorb :match "(?i)vt\\s*preciseorb" :category :tracking :subcategory :precise
   :tiers #{:novice :intermediate :advanced}
   :skills {:control-tracking/wrist 0.4 :control-tracking/fingertip 0.35 :flick-tech/micro 0.25}
   :amplitude :small :target-kinematics :constant-vel :muscle {:wrist 0.8 :fingers 0.2}}

  {:id :vt4/plaza      :match "(?i)vt\\s*plaza" :category :tracking :subcategory :reactive
   :tiers #{:novice :intermediate :advanced}
   :skills {:reactive-tracking/control 0.45 :reactive-tracking/reading 0.25 :control-tracking/wrist 0.3}
   :amplitude :medium :target-kinematics :erratic :muscle {:wrist 0.6 :arm 0.4}}

  {:id :vt4/air        :match "(?i)vt\\s*air\\s+(novice|intermediate|advanced)" :category :tracking :subcategory :reactive
   :tiers #{:novice :intermediate :advanced}
   :skills {:control-tracking/arm 0.4 :reactive-tracking/control 0.35 :control-tracking/blending 0.25}
   :amplitude :large :target-kinematics :erratic :muscle {:arm 0.8 :wrist 0.2}}

  ;; ---------------- SWITCHING ----------------
  {:id :vt4/psalm-ts   :match "(?i)psalmts" :category :switching :subcategory :speed
   :tiers #{:novice :intermediate :advanced}
   :skills {:flick-tech/stability 0.35 :click-timing/precision 0.3 :click-timing/reading 0.2 :flick-tech/micro 0.15}
   :amplitude :medium :target-kinematics :static :muscle {:wrist 0.7 :arm 0.3}}

  {:id :vt4/sky-ts     :match "(?i)skyts" :category :switching :subcategory :speed
   :tiers #{:novice :intermediate :advanced}
   :skills {:flick-tech/stability 0.35 :reactive-tracking/reading 0.35 :click-timing/precision 0.3}
   :amplitude :large :target-kinematics :static :muscle {:arm 0.6 :wrist 0.4}}

  {:id :vt4/eva-ts     :match "(?i)evats" :category :switching :subcategory :evasive
   :tiers #{:novice :intermediate :advanced}
   :skills {:reactive-tracking/control 0.3 :reactive-tracking/reading 0.3 :flick-tech/stability 0.25 :click-timing/precision 0.15}
   :amplitude :medium :target-kinematics :erratic :muscle {:wrist 0.5 :arm 0.5}}

  {:id :vt4/bounce-ts  :match "(?i)bouncets" :category :switching :subcategory :evasive
   :tiers #{:novice :intermediate :advanced}
   :skills {:reactive-tracking/control 0.3 :reactive-tracking/reading 0.5 :click-timing/precision 0.2}
   :amplitude :medium :target-kinematics :bouncing-predictable :muscle {:wrist 0.6 :arm 0.4}}]

